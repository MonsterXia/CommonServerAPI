{
  "name": "common-server-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "prisma generate && wrangler deploy",
    "start": "wrangler dev --var APP_ENV:development",
    "dev": "wrangler dev --var APP_ENV:development",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
